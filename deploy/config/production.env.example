# Non-secret production configuration. Copy to:
# /opt/welove-shop/config/production.env
# Do not put passwords, API keys, or tokens here.

# Deployment, image source and public endpoints
# The server pulls application images from this prefix. Production releases set
# it to the configured ACR registry and namespace automatically.
IMAGE_PREFIX=ghcr.io/replace-with-github-owner-lowercase
IMAGE_TAG=bootstrap
SHOP_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.shop.example.com
ALLOWED_ORIGINS=https://shop.example.com,https://admin.shop.example.com
IMAGE_BASE_URL=https://cdn.example.com
CLOUD_STORAGE_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Java services / Nacos
SPRING_PROFILES_ACTIVE=prod
NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_NAMESPACE=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
MAX_FILE_SIZE=50MB
UPLOAD_DIR=/data/uploads
UPLOAD_TEMP_DIR=/tmp/welove-shop

# AI service: network, retrieval and model selection (no credentials)
PG_HOST=postgres
PG_PORT=5432
PG_USER=welove_app
PG_NAME=welove_shop_search
PG_LANGGRAPH_DB=welove_shop_search
PG_BUSINESS_DB=welove_shop_search
PG_BUSINESS_SEARCH_PATH=product_svc,user_svc,trade_svc,chat_svc,admin_svc,public
JAVA_API_BASE_URL=http://gateway:8080
JAVA_API_TIMEOUT_SECONDS=5
MILVUS_URL=https://replace-with-zilliz-endpoint
MILVUS_COLLECTION=knowledge_v21_fixed
MILVUS_PRODUCT_COLLECTION=product_mm_collection
MILVUS_PRODUCT_V2_COLLECTION=product_mm_v2
MILVUS_PRODUCT_THREE_PATH_COLLECTION=product_multimodal_prod_v1
# product_multimodal_prod_v1 导入并完成云端回归后，设为 true。
SHOPPING_MULTIMODAL_USE_THREE_PATH_COLLECTION=false
MILVUS_DENSE_DIM=1024
MILVUS_IMAGE_DIM=2560
MILVUS_MULTIMODAL_DIM=2560
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_PARENT_CHILD_ENABLED=false
RAG_PARENT_CHILD_CHUNKING=recursive_v23
RAG_INITIAL_TOP_K=20
DASH_SCOPE_TEXT_EMBEDDING_MODEL=text-embedding-v4
DASH_SCOPE_TEXT_RERANK_MODEL=qwen3-rerank
DASH_SCOPE_MULTI_MODAL_EMBEDDING_MODEL=qwen3-vl-embedding
DASH_SCOPE_MULTI_MODAL_RERANK_MODEL=qwen3-vl-rerank
DASH_SCOPE_RERANK_TIMEOUT=5
SHOPPING_LLM_JUDGE_ENABLED=true
SHOPPING_LLM_JUDGE_MAX_CANDIDATES=10
SHOPPING_LLM_JUDGE_MIN_SCORE=0.55

# Skills-driven domain agents and bounded complex-task execution
SHOPPING_DEEP_AGENT_ENABLED=true
SHOPPING_SKILLS_ROOT=/skills/shopping-agent/
KNOWLEDGE_DEEP_AGENT_ENABLED=true
KNOWLEDGE_SKILLS_ROOT=/skills/knowledge-agent/
SHOPPING_SKILL_SCRIPT_MODE=controlled
SHOPPING_SKILL_SCRIPT_TIMEOUT_SECONDS=2
ORCHESTRATOR_MAX_TASKS=5
ORCHESTRATOR_MAX_DEPTH=4
ORCHESTRATOR_MAX_CONCURRENCY=3
ORCHESTRATOR_TASK_TIMEOUT_SECONDS=60

# Multimodal retrieval and image/text consistency checking
SHOPPING_MULTIMODAL_RETRIEVAL_TIMEOUT_SECONDS=12
SHOPPING_MULTIMODAL_CONSISTENCY_ENABLED=true
SHOPPING_MULTIMODAL_CONSISTENCY_MODEL=qwen3.5-flash
SHOPPING_MULTIMODAL_CONSISTENCY_TIMEOUT_SECONDS=6
DASHSCOPE_MAAS_BASE_URL=https://replace-with-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1

# Shared rolling summary and per-conversation request serialization
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=20
CONVERSATION_SUMMARY_KEEP_MESSAGES=4
CONVERSATION_SUMMARY_MAX_CHARS=1600
CHAT_TURN_LOCK_LEASE_MILLIS=330000

# Production tracing is opt-in. Keep user inputs/outputs hidden when enabled.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=welove-shop-ai-prod
LANGSMITH_ENVIRONMENT=production
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# KnowledgeAgent web-search fallback. With BOCHA_API_KEY set in the secrets
# file, use the installed MCP package first and fall back to Bocha HTTP.
BOCHA_MCP_COMMAND=python
BOCHA_SEARCH_TIMEOUT=5.0

# Frontend note: both H5 frontends call same-origin /api, so no API base URL
# is required. Their image host is currently a build-time VITE_IMAGE_BASE_URL;
# keep that value aligned with IMAGE_BASE_URL until runtime frontend config is added.

# OpenAI-compatible LLM config.
# Do not put real secrets in this example file.
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model-name
LLM_BASE_URL=https://api.openai.com/v1

# ── 多 Agent DAG 编排 ──
ORCHESTRATOR_MAX_TASKS=5
ORCHESTRATOR_MAX_DEPTH=4
ORCHESTRATOR_MAX_CONCURRENCY=3
ORCHESTRATOR_TASK_TIMEOUT_SECONDS=30

# ── 低成本混合路由 ──
# 高确定性规则达到该阈值时直接路由，不调用 LLM。
ROUTER_RULE_MIN_CONFIDENCE=0.90
# LLM 路由低于该阈值时进入 unknown 澄清兜底，避免静默误路由。
ROUTER_LOW_CONFIDENCE_THRESHOLD=0.65
# DAG 子任务复用 Orchestrator intent_hint 时记录的路由置信度。
ROUTER_ORCHESTRATOR_HINT_CONFIDENCE=0.90

# ── 用户偏好软重排 ──
PERSONALIZATION_POSITIVE_BOOST=0.08
PERSONALIZATION_NEGATIVE_PENALTY=0.12
PERSONALIZATION_MULTIMODAL_WEIGHT=0.15

# ── RAG embedding：DashScope text-embedding-v4（主用）──
# RAG 稠密向量走这里。dashscope Python SDK 已 pip install，只需要下面两个 key。
# dimension 通过 MILVUS_DENSE_DIM 配置（1024 是我们锁的默认值，v4 也支持 2048/1536/768/512/256/128/64）。
# 改 MILVUS_DENSE_DIM 需要先跑 scripts/drop_milvus_collection.py 清库重建。
DASH_SCOPE_API_KEY=replace-with-your-dashscope-key
DASH_SCOPE_TEXT_EMBEDDING_MODEL=text-embedding-v4
DASH_SCOPE_EMBEDDING_BATCH_SIZE=10

# ── DashScope rerank (qwen3-rerank) ──
# 两阶段检索：hybrid 召回 20 条 → rerank 精排到 top 5。
# 端点用公共 dashscope.aliyuncs.com（专属部署不带 rerank 服务）。
DASH_SCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
DASH_SCOPE_TEXT_RERANK_MODEL=qwen3-rerank
DASH_SCOPE_RERANK_TIMEOUT=5.0
# 初始召回数：hybrid 一路给 rerank 送多少候选。20 是经验值。
RAG_INITIAL_TOP_K=20

# ── Milvus + embedding 维度 ──
MILVUS_URL=http://127.0.0.1:19530
# Zilliz Cloud: set this to the cluster API token. Keep empty for local Milvus.
MILVUS_TOKEN=
MILVUS_COLLECTION=my_rag_collection
# DashScope text-embedding-v4 支持 2048/1536/1024/768/512/256/128/64，锁 1024
MILVUS_DENSE_DIM=1024

# ── 商品多模态 collection（Phase 1b 起启用）──
# 商品向量迁到独立 collection，schema 三向量字段：text_dense + text_sparse(BM25 Function) + multimodal（预留）。
# MVP：只给 text_dense/text_sparse 建索引；tongyi-vision-flash 用于 Phase 2 图+文融合。
MILVUS_PRODUCT_COLLECTION=product_mm_collection

# ── 商品多模态 v2 collection（实验链路，不影响旧 collection）──
# product_mm_v2 用于评测图文混合召回：text_dense + BM25 + image_vector + multimodal_vector。
MILVUS_PRODUCT_V2_COLLECTION=product_mm_v2
# 生产三路图文商品检索：text dense + BM25 + image（不写 multimodal_vector）。
MILVUS_PRODUCT_THREE_PATH_COLLECTION=product_multimodal_prod_v1
# 仅在三路生产 collection 导入并完成回归后设为 true。
SHOPPING_MULTIMODAL_USE_THREE_PATH_COLLECTION=false
MILVUS_IMAGE_DIM=2560
MILVUS_MULTIMODAL_DIM=2560

# ── 多模态 Embedding / Rerank（qwen3-vl）──
DASH_SCOPE_MULTI_MODAL_EMBEDDING_MODEL=qwen3-vl-embedding
DASH_SCOPE_MULTI_MODAL_RERANK_MODEL=qwen3-vl-rerank
SHOPPING_LLM_JUDGE_ENABLED=true
SHOPPING_LLM_JUDGE_MAX_CANDIDATES=10
SHOPPING_LLM_JUDGE_MIN_SCORE=0.55
# Deep Agents Skill runtime. Skill-driven ShoppingAgent is enabled by default.
SHOPPING_DEEP_AGENT_ENABLED=true
SHOPPING_SKILLS_ROOT=/skills/shopping-agent/
# disabled: 不提供脚本工具；controlled: 只允许运行仓库白名单 scripts；sandbox: 预留。
SHOPPING_SKILL_SCRIPT_MODE=controlled
SHOPPING_SKILL_SCRIPT_TIMEOUT_SECONDS=2
SHOPPING_MULTIMODAL_RETRIEVAL_TIMEOUT_SECONDS=12
# Deep Agents Skill runtime. Skill-driven KnowledgeAgent is enabled by default.
KNOWLEDGE_DEEP_AGENT_ENABLED=true
KNOWLEDGE_SKILLS_ROOT=/skills/knowledge-agent/
# 百炼业务空间端点。把 {WorkspaceId} 换成真实业务空间 ID；不配置时使用 dashscope SDK 默认端点。
DASHSCOPE_MAAS_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1

# ── OpenAI 兼容通道（历史遗留，保留兼容，不再是主用 embedding）──
OPENAI_API_KEY=replace-with-your-embedding-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# RAG chunk config.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Parent-child is disabled for the default single-layer knowledge collection.
# Mixed parent-child experiments keep product semantic chunks direct and use
# parent-child records only for general knowledge.
RAG_PARENT_CHILD_ENABLED=false
RAG_PARENT_CHILD_CHUNKING=recursive_v23
RAG_PARENT_CHILD_GENERAL_ONLY=false

# MySQL config for shopping recommendation.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=welove_shop_db
DB_USER=root
DB_PASSWORD=replace-with-your-db-password
DB_CHARSET=utf8mb4

# pgvector config for product vector search.
PG_HOST=localhost
PG_PORT=5432
PG_NAME=welove_shop_search
PG_USER=root
PG_PASSWORD=replace-with-your-pg-password
# PG 业务主库
# 单实例单库 + 多 schema 架构：Java 微服务和 Python ai-service 共用 welove_shop_search。
# schema 分工：product_svc / user_svc / trade_svc / chat_svc / admin_svc / public。
# 从 MySQL 迁移过来的历史命名 "welove_shop_db" 已废弃，不要再用。
PG_BUSINESS_DB=welove_shop_search

# 商品图片 CDN base URL：多模态 embedding / rerank 调 DashScope 前把相对路径拼成绝对 URL。
# 前端 VITE_IMAGE_BASE_URL 保持独立；这里给后端多模态链路用。
IMAGE_BASE_URL=https://liangwenjun.oss-cn-hangzhou.aliyuncs.com

# Java 后端服务地址（Python agent 通过 HTTP 调 Java 拿业务数据：收藏/浏览/订单等）
# 超时默认 2s（Java 挂时快速失败走 PG 降级），生产可根据 Java 实际响应时长拉到 5-10s
JAVA_API_BASE_URL=http://localhost:8888
JAVA_API_TIMEOUT_SECONDS=2

# LangSmith 追踪配置（可观测性）。留空则不上报，不影响功能。
# 本地调试可把 LANGSMITH_TRACING 改为 true 并填入 API Key。
# Project 建议按环境隔离，例如 welove-shop-ai-dev / -staging / -prod。
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=welove-shop-ai-dev
LANGSMITH_ENVIRONMENT=development
# 示例默认不上传请求/响应正文，避免误把聊天或画像数据送入观测平台。
# 本地定位 Prompt、工具参数或模型输出时，可仅在 .env 中改为 false。
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# CORS 允许的前端来源（逗号分隔）。生产环境务必明确列出前端域名，不要用 "*"。
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# ── 博查 Web 搜索兜底（KnowledgeAgent 内部知识库不足时自动触发）──
# 不配置 BOCHA_API_KEY 时不启用兜底，KnowledgeAgent 行为不变。
# 申请地址：https://open.bochaai.com/
BOCHA_API_KEY=
# MCP 启动命令（默认 uvx，也可换成 npx 或留空走 HTTP 直连）
BOCHA_MCP_COMMAND=uvx
# 博查兜底超时秒数（兜底不应拖慢主流程）
BOCHA_SEARCH_TIMEOUT=5.0

# Optional integration test config.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
RUN_EMBEDDING_TESTS=0
RUN_MILVUS_TESTS=0
RUN_DASHSCOPE_TESTS=0

# Optional Phase-4 offline evaluation. Install requirements-eval.txt only on an
# evaluation machine. These values are intentionally separate from production
# routing credentials so Judge/RAGAS cost is explicit and controllable.
DEEPEVAL_MODEL=
RAGAS_EVAL_API_KEY=
RAGAS_EVAL_BASE_URL=
RAGAS_EVAL_MODEL=
RAGAS_EVAL_EMBEDDING_MODEL=
